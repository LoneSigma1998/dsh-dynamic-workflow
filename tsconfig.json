{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@zcode/dynamic-workflow": ["./vendor/dynamic-workflow/src/index.ts"],
      "@zcode/dynamic-workflow/projections": ["./vendor/dynamic-workflow/src/projections.ts"],
      "@zcode/dynamic-workflow/testing": ["./vendor/dynamic-workflow/src/testing/index.ts"],
      "@zcode/dynamic-workflow-runtime": ["./vendor/dynamic-workflow-runtime/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "lib", "vendor/**/tests/**"]
}
