# Copy to .env (gitignored) for `npm run test:live`. The Claude-style names work too:
# ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_DEFAULT_OPUS_MODEL.
DWF_E2E_BASE_URL=http://gateway.example:3425
DWF_E2E_API_KEY=sk-...
DWF_E2E_MODEL=provider/model-id
# DSH_BIN=dsh
# DWF_E2E_INSTALL=1   # install with `dsh plugin add` instead of inserting lib/index.js by path
# DWF_E2E_KEEP=1      # keep the temp workspace + DSH_HOME for inspection
